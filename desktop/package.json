{
  "name": "read-aloud-pro",
  "version": "1.3.0",
  "description": "Reads text from any program aloud with word highlighting, finds key words, and writes emails and documents with Claude.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.7",
    "kokoro-js": "^1.2.1",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@45.2.3": true,
    "koffi@3.3.7": true
  },
  "productName": "Read Aloud Pro",
  "build": {
    "appId": "com.readaloudpro.app",
    "productName": "Read Aloud Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "renderer/**",
      "package.json"
    ],
    "asarUnpack": [
      "src/*.ps1",
      "node_modules/koffi/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "renderer/icons/icon256.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Read Aloud Pro"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "JnoAYLV",
        "repo": "read-aloud-pro",
        "releaseType": "release"
      }
    ],
    "artifactName": "Read-Aloud-Pro-Setup-${version}.${ext}"
  }
}
